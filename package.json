{
  "name": "delta-force-core",
  "version": "0.2.5",
  "description": "三角洲行动核心数据与随机抽签库（干员 / 武器 / 装备 / 子弹）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.json": "./index.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.json",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && npm run emit-json",
    "dev": "tsc --watch",
    "emit-json": "node scripts/emit-json.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "delta-force",
    "三角洲行动",
    "game-data",
    "random",
    "loadout",
    "typescript"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
