{
  "name": "delta-force-core",
  "version": "0.7.2",
  "description": "三角洲行动核心数据与随机抽签库（干员 / 武器 / 装备 / 子弹）",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "delta-force-mcp": "./bin/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./index.json": "./index.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "bin",
    "index.json",
    "README.md",
    "README.en.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc && npm run emit-json",
    "dev": "tsc --watch",
    "emit-json": "node scripts/emit-json.mjs",
    "mcp": "node bin/mcp.js",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Zhoyi011/delta-force-core.git"
  },
  "homepage": "https://github.com/Zhoyi011/delta-force-core#readme",
  "bugs": {
    "url": "https://github.com/Zhoyi011/delta-force-core/issues"
  },
  "keywords": [
    "delta-force",
    "三角洲行动",
    "game-data",
    "random",
    "loadout",
    "typescript",
    "mcp",
    "model-context-protocol",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.4.5"
  }
}
